# Raise One — variáveis de ambiente

# Senha do painel admin (/admin)
ADMIN_PASSWORD=defina-uma-senha-forte

# PINs opcionais por pessoa (se omitidos, só senha do time é exigida)
ADMIN_PIN_LUAN=
ADMIN_PIN_VINI=
ADMIN_PIN_CAIO=

# Supabase — persistência da Central em produção (opcional; sem isso usa data/execution.json)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Segredo para assinar cookies de sessão (mín. 32 caracteres)
SESSION_SECRET=altere-para-um-valor-aleatorio-longo

# WhatsApp com DDI (ex: 5513999999999) — usado nos links wa.me
VITE_WHATSAPP_NUMBER=5513999999999

# Instagram (opcional)
VITE_INSTAGRAM_URL=https://instagram.com/raiseone

# Serper — resultados reais do Google na prévia SERP (recomendado)
# Crie conta em https://serper.dev (2.500 queries grátis)
SERPER_API_KEY=

# Preferência SERP: ads (anúncios → orgânico → mock) | organic | hybrid
SERP_PREFER=ads

# Rate limit SERP (chamadas live ao Serper/CSE — cache não conta)
# IPs separados por vírgula com bypass total (localhost já incluso)
SERP_RATE_LIMIT_BYPASS_IPS=
# Máximo de buscas live por IP por hora / por dia (visitantes em produção)
SERP_RATE_LIMIT_MAX_HOUR=8
SERP_RATE_LIMIT_MAX_DAY=20
# Opcional: header X-Serp-Dev-Bypass com este valor ignora o limite (só dev)
SERP_DEV_BYPASS_SECRET=

# Google Custom Search — fallback opcional (motores novos não suportam web inteira)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
