# Raise One — variáveis de ambiente

# ── Raise One OS (obrigatório) ──────────────────────────────

# Supabase — persistência de todas as empresas e dados do OS
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Senha do painel /os/login
ADMIN_PASSWORD=defina-uma-senha-forte

# Segredo para assinar cookies de sessão (mín. 32 caracteres)
SESSION_SECRET=altere-para-um-valor-aleatorio-longo

# Cron Vercel — publicação automática de conteúdos programados (22h BRT)
# Hobby: 1x/dia (vercel.json usa 0 1 * * * UTC ≈ 22h America/Sao_Paulo). Pro: pode usar 0 * * * *.
CRON_SECRET=altere-para-um-valor-aleatorio-longo

# PINs opcionais por pessoa (se omitidos, só senha do time é exigida)
ADMIN_PIN_LUAN=
ADMIN_PIN_VINI=
ADMIN_PIN_CAIO=

# ── Site público ────────────────────────────────────────────

# WhatsApp com DDI (ex: 5513999999999) — usado nos links wa.me
VITE_WHATSAPP_NUMBER=5513999999999

# Instagram (opcional)
VITE_INSTAGRAM_URL=https://instagram.com/raiseone

# Serper — resultados reais do Google na prévia SERP (recomendado)
SERPER_API_KEY=

# Preferência SERP: ads | organic | hybrid
SERP_PREFER=ads

# Rate limit SERP
SERP_RATE_LIMIT_BYPASS_IPS=
SERP_RATE_LIMIT_MAX_HOUR=8
SERP_RATE_LIMIT_MAX_DAY=20
SERP_DEV_BYPASS_SECRET=

# Google Custom Search — fallback opcional
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# OpenRouter — LLM do Raise One OS (Copilot e futuros agentes)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_STT_MODEL=openai/whisper-large-v3
# OPENROUTER_SITE_URL=https://raiseone.com.br
# OPENROUTER_APP_NAME=Raise One OS

# OpenAI — legado (Copilot usa OpenRouter se configurado)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# ── Raise One Client (portal) ───────────────────────────────

# Base URL dos magic links (dev: mesma porta do vite, ex. 8080)
CLIENT_APP_URL=http://localhost:8080

# E-mail (prod) — Resend
# RESEND_API_KEY=
# CLIENT_EMAIL_FROM=Raise One <acesso@seudominio.com>
